# Copy to .env for local development. Never commit real keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_FALLBACK_MODELS=cohere/north-mini-code:free
ALLOWED_ORIGINS=http://localhost:5173
CORPUS_PATH=data/fixtures/corpus.jsonl
INDEX_PATH=data/fixtures/index.npz
# lexical is an explicitly labelled development mode; production uses hybrid.
RETRIEVAL_MODE=lexical
EMBEDDING_CACHE=.cache/fastembed
RATE_LIMIT_PER_MINUTE=8
MAX_CONCURRENT_CHATS=1
PORT=8000
